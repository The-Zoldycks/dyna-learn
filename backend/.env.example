GEMINI_API_KEY=your_key_here
PORT=3000
FRONTEND_URL=http://localhost:5173
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback automatically tries gemini-3-flash-preview, gemini-flash-latest if 404

# Edge TTS self-hosted (Toolbox parity, in-process, no cold start, no key)
# No env needed — voices fetched live from speech.platform.bing.com
# Optional overrides: VOICE default en-US-AriaNeural, rate +0% — see GET /api/tts/voices
