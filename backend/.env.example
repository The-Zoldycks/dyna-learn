GEMINI_API_KEY=your_key_here
PORT=3000
FRONTEND_URL=http://localhost:5173
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback automatically tries gemini-3-flash-preview, gemini-flash-latest if 404

# Qwen3-TTS (optional, no-budget fallback to browser SpeechSynthesis if missing)
# Get free-tier key at https://dashscope.console.aliyun.com — set to enable selectable neural voices
# DASHSCOPE_API_KEY=sk-xxxx
# DASHSCOPE_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# VOICE selectable: Vivian|Serena|Uncle_Fu|Dylan|Eric|Ryan|Aiden|Ono_Anna|Sohee
