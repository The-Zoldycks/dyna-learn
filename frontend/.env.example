# Dyna-learn Frontend Environment Configuration
# Copy this file to .env or .env.local

# Backend API URL (Express server for Gemini & Edge TTS)
VITE_BACKEND_URL=http://localhost:3000

# Supabase Cloud Sync & Authentication (Free tier at https://supabase.com)
# When left blank, Dyna-learn automatically operates in 100% offline Guest Mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
